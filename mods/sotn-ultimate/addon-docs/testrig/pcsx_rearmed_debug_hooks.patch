+unsigned int dbg_watch_lo = 0, dbg_watch_hi = 0;
+unsigned int dbg_watch_n = 0;
+unsigned int dbg_watch_log[4096][6];
+static inline void dbg_watch(psxRegisters *regs, u32 mem, u32 value, u32 size) {
+	u32 a = mem & 0x1fffff;
+	if (a + size > dbg_watch_lo && a < dbg_watch_hi) {
+		unsigned int *e = dbg_watch_log[dbg_watch_n & 4095];
+		e[0] = regs->pc; e[1] = mem; e[2] = value; e[3] = size;
+		e[4] = regs->GPR.n.ra; e[5] = regs->cycle;
+		dbg_watch_n++;
+	}
+}
