# Matches globally
ctx.c
ctx.c.m2c
sotn_calltree.txt
__pycache__
.idea/
.venv/
asm/
build/
release/
expected/
rpt/
disks/
nonmatchings/
.vscode/settings.json

# Unsure if these are directories or files
function_calls
gmon.out

# Temporary files that are used during make format-src and make format-symbols respectively
format-src.run
format-symbols.run

# Matches in repo root folder only
/*.map
/assets/

# ninja stuff
.ninja_lock
.ninja_log
.ninja_deps
build.ninja
build.ninja.version

# objdiff stuff
objdiff*.json

# rust
target/**

# in-game generated recording files
recordings/
# Generated by tools/saturn-splitter from config/saturn/*.yaml
/config/saturn/*.ld
/config/saturn/*.gen.txt

# SOTN Ultimate mod: generated by mods/sotn-ultimate/tools/build_disc.sh from the player's
# own discs (disks/), never committed
src/**/mod_psp_script.h
src/**/mod_layout.h
src/**/mod_layout2.h
src/**/mod_rooms.h
src/**/mod_sconce.h
src/**/mod_*_sfx.h
src/st/no3/mod_horse.h
src/st/sel/mod_charsel_gfx.h
src/st/sel/mod_sel_soundmode_gfx.h
src/st/sel/mod_jp_xa.h
src/st/lib/mod_bestiary.h
src/dra/mod_psp_xa.h
src/dra/mod_xa_music.h
# the retranslation pack's switch (text_packs.py --header: whether the
# builder had disks/jpre, the patched Japanese disc's files)
mods/sotn-ultimate/include/mod_text_rt.h
# the builder: its bundle, and pages with a patch in them
mods/sotn-ultimate/tools/builder/dist/
mods/sotn-ultimate/tools/builder/web/*.generated.html
# editor backups
*.pre_*
# the tile swap atlases are rebuilt from the discs (tile_atlases.ts)
mods/sotn-ultimate/tools/gdn_ps1_tiles/*.png
mods/sotn-ultimate/tools/prs_ps1_tiles/*.png
